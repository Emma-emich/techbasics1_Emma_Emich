#the function def show_room_items prints the name of each item for the player


def show_room_items():
    print("\nYou can see:")
    for item in items_in_room:
        print(item["name"])

#now the player will look into their inventory and check what they are currently carrying and see that the list is empty so the code will tell the player so

def show_inventory():
    if not inventory:
        print("Your inventory is empty.")
    else:
        print(f"\nInventory ({len(inventory)}/{MAX_ITEMS}):")# len to show the numbers of items in the list
        for item in inventory:
            print(item["name"])

#the player finds the key and this function lets him pick it up. With item_in_room
# the function will gor through the the list to check if the key is there , if it is
# we will remove it by using .remove() and add it to the inventory list by using .append()
def pick_up_key():
    for item in items_in_room:
        if item["name"] == "key":
            inventory.append(item)
            items_in_room.remove(item)
            print(f"You picked up the key.")
            return
    print(f"there is no key in your room.")

#now drop_key checks if the key is in the inventory and drops it
def drop_key():
    for item in inventory:
        if item["name"] == "key":
            inventory.remove(item)
            items_in_room.append(item)
            print(f"You dropped the key.")
            return
    print(f"You don't have a key in your inventory.")

#in this part the player needs to type in a code, if it is correct with key = {} a new dictionary will be created and it will be added to items_in_room and the player can pick it up then
def examine_cabinet():
    cabinet_found = False
    for item in items_in_room:
            if item["name"] == "cabinet":
                cabinet_found = True
                if item["uses"] > 0:
                    print("There is a keypad lock at the cabinet.")
                    time.sleep(1)
                    print("You have to type in a code to open the cabinet.")
                    time.sleep(1)
                    code = input("Enter the code to open the cabinet: (Hint: it's the first four numbers that exist. ;))")
                    if code == "1234":
                        print("The lock opens and inside the cabinet you find an old metal key.")
                        key = {"name":"key","type":"tool", "uses":1, "description": "A small old metal key."}
                        items_in_room.append(key)
                        item["uses"]= 0 #set to 0 so the cabinet can only be opened once with the correct code through the right code in the lock
                        print("The key is now in the room. Go back to the menu and select 'pickup key' to pick the key up.")
                    else:
                        print("Wrong code. The cabinet stays closed")
                else:
                    print("The cabinet is already open.")
    if not cabinet_found:
                print("There is no cabinet in your room.")

